# ============================================================
#  منصة رواد النيل — إعدادات البيئة | Environment configuration
#  انسخ هذا الملف إلى .env ثم عدّل القيم
#  Copy this file to .env and adjust the values.
#  ⚠ لا ترفع ملف .env إلى المستودع مطلقاً | NEVER commit .env
# ============================================================

# --- Application ---------------------------------------------
APP_NAME="منصة رواد النيل"
APP_ENV=development           # development | testing | production
APP_DEBUG=true                # MUST be false in production
APP_URL=http://localhost:8000
APP_KEY=                      # 64 hex chars — generate: php bin/console key:generate

# مجلد التثبيت الفرعي — اتركه فارغاً إذا كان جذر الويب هو public/ نفسه.
# املأه فقط عند وضع المشروع داخل مجلد يخدمه الخادم، مثل htdocs/rowad
# في XAMPP، فيصبح الرابط http://localhost/rowad. بلا شرطة في النهاية.
# Subdirectory install prefix. Leave EMPTY when the web root is public/.
# Set it (e.g. /rowad) only for htdocs-style installs. No trailing slash.
# ⚠ عند ضبطه لا بدّ من وجود ملف .htaccess في جذر المشروع — بدونه يصبح
#   ملف .env ومجلد storage قابلين للتنزيل من المتصفّح. راجع docs/xampp-setup.md
APP_BASE_PATH=
APP_TIMEZONE=Africa/Cairo
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_CURRENCY=EGP

# --- Database (MySQL 8) --------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nilepreneurs
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_SOCKET=

# Separate database used by the automated test suite.
# ⚠ It is TRUNCATED on every test run — never point this at real data.
DB_TEST_DATABASE=nilepreneurs_test

# --- Session --------------------------------------------------
SESSION_NAME=NP_SESSION
SESSION_LIFETIME=120          # idle timeout (minutes)
SESSION_ABSOLUTE_LIFETIME=720 # absolute maximum session age (minutes)
SESSION_SECURE=false          # MUST be true in production (HTTPS only)
SESSION_SAMESITE=Lax

# --- Security -------------------------------------------------
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15
RATE_LIMIT_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=false            # enable only when HTTPS is live

# --- File uploads ---------------------------------------------
UPLOAD_MAX_SIZE=5242880       # 5 MB per file
UPLOAD_DOC_MAX_SIZE=10485760  # 10 MB for documents

# --- Mail (no provider credentials in the MVP) ----------------
MAIL_DRIVER=log               # log | smtp
MAIL_FROM_ADDRESS=no-reply@nilepreneurs.example
MAIL_FROM_NAME="منصة رواد النيل"
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# --- SMS (interface only in the MVP) --------------------------
SMS_DRIVER=log                # log | http
SMS_ENDPOINT=
SMS_SENDER_ID=
SMS_API_KEY=
