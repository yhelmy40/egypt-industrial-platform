# ============================================================
#  حارس جذر المشروع | Project-root guard
#
#  هذا الملف **ضروري فقط** عند تثبيت المشروع داخل مجلد يخدمه الخادم
#  مباشرةً — مثل `htdocs/rowad` في XAMPP. في هذه الحالة يصبح كل ما في
#  المجلد قابلاً للتنزيل من المتصفح: ملف `.env` بكلمات المرور، ومجلد
#  `storage` بالمستندات المرفوعة، و`vendor` بكل شيفرة الاعتماديات.
#
#  الملف يفعل أمرين:
#    1. يمنع الوصول إلى كل ما هو خارج `public/` منعاً صريحاً.
#    2. يوجّه ما تبقّى إلى `public/` فيعمل الموقع من الرابط المختصر.
#
#  ⚠ الأفضل دائماً أن يكون جذر الويب هو `public/` نفسه (مضيف افتراضي)،
#  فلا يصل الخادم إلى هذا المجلد أصلاً. راجع `docs/xampp-setup.md`.
# ============================================================

Options -Indexes

# ── 1. منع صريح لكل ما لا يخصّ المتصفّح ──────────────────────
#    الحظر أولاً ثم التوجيه: لو اعتمدنا على التوجيه وحده لكان أي خطأ
#    في قاعدة إعادة الكتابة كشفاً مباشراً لكلمات المرور.
#
#    `legacy` مُدرج هنا عمداً: بداخله مجلد `public` خاص به، وقد كان
#    ينفَّذ فعلياً عبر المتصفّح قبل إضافته إلى هذه القائمة.
#
#    ⛔ لا تُضِف `app` إلى هذه القائمة. `/app` هي بادئة 173 مساراً
#    لمنطقة المستخدم المسجَّل، وإضافتها تُسقِط المنصة بالكامل بعد
#    تسجيل الدخول بخطأ 404. مجلد `app/` نفسه محميّ بملف `app/.htaccess`،
#    وهي حماية موضعية لا تلمس التوجيه. القاعدة نفسها تنطبق على أي اسم
#    يظهر في `routes/web.php` كمقطع أول.
#
#    البادئة `(?i)` مقصودة وليست زينة: نظام ملفات ويندوز لا يفرّق بين
#    الأحرف الكبيرة والصغيرة، بينما مطابقة أباتشي حسّاسة لها. بدونها
#    يمرّ `/VENDOR/autoload.php` من فوق الحظر ويُقرأ الملف كما هو على
#    XAMPP. لا يمكن كشف هذا على لينكس لأن الملف لن يوجد أصلاً.
RedirectMatch 404 (?i)^/(?:.*/)?(config|database|docs|routes|storage|tests|vendor|bin|legacy|resources)(/|$)
RedirectMatch 404 (?i)^/(?:.*/)?\.(env|git|github)(/|$)

#    مجلد `app/` هو الاستثناء الوحيد: لا يمكن حظر الاسم (لأنه بادئة
#    مسارات التطبيق) ولا وضع حارس بداخله (لأن أباتشي يمرّ على المجلد
#    الحقيقي قبل إعادة الكتابة فيردّ 403 على كل صفحة بعد الدخول).
#    الحلّ: الحظر بالامتداد. مسارات التطبيق بلا امتداد
#    (`/app/crm/customers`) فلا تتأثّر، بينما `/app/Core/Kernel.php`
#    يُحجب حتى لو كان mod_rewrite معطّلاً.
RedirectMatch 404 (?i)^/(?:.*/)?app/.*\.(php|phtml|inc)$

<FilesMatch "(?i)^(\.env.*|composer\.(json|lock)|phpunit\.xml.*|package(-lock)?\.json|.*\.md|.*\.sql|.*\.bak|.*\.log)$">
    Require all denied
</FilesMatch>

# ── 2. توجيه كل شيء إلى مجلد الويب العام ─────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # النمط هنا نسبيّ لمجلد المشروع (أباتشي يقتطع بادئة المجلد تلقائياً)،
    # فـ `(?!public/)` تستثني مجلد الويب العام لهذا المشروع وحده وتمنع
    # الحلقة اللانهائية.
    #
    # ⚠ لا تستبدلها بـ `RewriteCond %{REQUEST_URI} !^.*/public/` — ذلك
    # الشرط يطابق أي مقطع اسمه `public` في أي عمق، فيخرج مثلاً
    # `legacy/public/index.php` من التوجيه ويُنفَّذ مباشرةً في المتصفّح.
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>
