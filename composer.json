{
    "name": "nilepreneurs/sme-platform",
    "description": "منصة رواد النيل لتمكين المشروعات الصغيرة والمتوسطة — NilePreneurs SME Marketplace & Business Enablement Platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-gd": "لإعادة ترميز الصور المرفوعة وإسقاط أي حمولة مدسوسة فيها. بدونه تُخزَّن الصور بلا إعادة ترميز ويُسجَّل تحذير — راجع فحص `php bin/console health`."
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Migrations\\": "database/migrations/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/console migrate",
        "seed": "php bin/console seed"
    }
}
